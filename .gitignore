# InDesign lock files — present only while a .indd is open
*.idlk
~*.idlk

# InDesign's own format. The toolchain reads and writes IDML only, so a .indd here
# is the Save dialog's default rather than a decision — and it is ~13 MB a time.
# Export IDML instead; that is what a submission is.
*.indd

# Python
__pycache__/
*.pyc

# Unpacked IDML working trees and pipeline outputs — reproducible from the tracked
# inputs via the toolchain (see README). Git history is the archive for anything
# that was tracked before; recover with `git show <rev>:<path>`.
manuals/*/build/
manuals/*/build*.csv
manuals/*/out/
manuals/*/*_v[0-9]*.idml

# CI staging for the `latest` release, and what fetch_build.py pulls back down
dist/
downloads/

# legacy top-level working trees (pre-restructure)
extracted/
template_build/
template_build_18/
template_build_masters/
template_build_tabproof/
