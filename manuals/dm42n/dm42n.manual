# Per-manual configuration. Lives NEXT TO the build dir, never inside it, so it
# is not packed into the .idml. Discovery: <build>.manual, then *.manual in the
# build's parent, then the kit's default.
#
# key = value, # comments, blank lines ignored. `swatch` may repeat.

# Sanctioned palette. prune_swatches.py keeps these even when unused;
# validate_idml.py flags any applied colour that is not listed (a mixed ink built
# only from listed inks counts as listed). Black plus up to 3 spots, Black always.
swatch = PANTONE 130 U
swatch = PANTONE Warm Gray 1 U
swatch = Black

# How many of titles:lvl1..lvl4 this manual uses, counting from the top.
# Optional. It does NOT fix numbering -- content starting at lvl1 already numbers
# correctly. It lets validate_idml.py catch content that SKIPS the top level
# (the cause of a leading zero, "0.1.4") or reaches deeper than declared.
levels = 4

# Which heading level carries a thumb tab and an InDesign section. Optional;
# without it the shallowest level present is used. Declare it when that is not
# what you want -- 5 lvl1 parts and 23 lvl2 sections means tabs on lvl2, not 5 tabs.
tab_level = 2

# Tab-strip ink ramp, top of the strip to the bottom. A bare ink name is that ink
# at 100%; a mix is "PANTONE 292 U 60%, Black 40%". Percentages are per-ink and
# independent. N tabs are tweened between these stops; a tab landing on a single
# ink becomes a plain Color/ + FillTint so the spot prints solid.
tab_stop = PANTONE 130 U
tab_stop = PANTONE 130 U, Black

# Sections number straight through the parts: a Part is a label, not a counter.
number_from = 2

# Which parts of the kit are AUTHORITATIVE for a manual: masters, styles, swatches
# (comma-separated). A poured document owns a private copy of the design system and
# nothing links it back, so a later kit change reaches new pours only. Declaring this
# re-transplants those parts on every build, making the kit the source of truth.
# Undeclared, sync_from_kit.py only reports what has drifted. Opt in per manual --
# overwriting a book's masters is not something to do by surprise, so this default
# is deliberately NOT inherited as "on".
# sync = masters

# The tab shows the running section number of the last numbered heading that
# begins on or before the page ("2.3.2", dropping to "2.3" where no lvl4 has been
# reached yet). It varies per page, so apply_tabs leaves the frame empty and
# place_tab_numbers.jsx fills it inside InDesign.
tab_shows = paragraph_number
